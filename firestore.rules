rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil de usuario: cada uno solo puede escribir el suyo.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      function isMember() {
        return request.auth != null
          && request.auth.uid in resource.data.memberIds;
      }

      // Crear: el creador debe incluirse a sí mismo como único miembro inicial.
      allow create: if request.auth != null
        && request.resource.data.memberIds == [request.auth.uid];

      // Leer: cualquier usuario autenticado (necesario para unirse por código;
      // los códigos de invitación actúan como secreto compartido).
      allow read: if request.auth != null;

      // Actualizar: miembros del grupo, o un usuario que se une a sí mismo.
      allow update: if isMember()
        || (request.auth != null
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
            && request.auth.uid in request.resource.data.memberIds);

      // Eliminar: cualquier miembro del grupo.
      allow delete: if isMember();

      // Movimientos: solo miembros del grupo.
      match /entries/{entryId} {
        function isGroupMember() {
          return request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        }
        allow read, create, update, delete: if isGroupMember();
      }

      // Agenda de la casa (tareas/actividades): solo miembros del grupo.
      match /tasks/{taskId} {
        function isGroupMember() {
          return request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        }
        allow read, create, update, delete: if isGroupMember();
      }

      // Notas compartidas: solo miembros del grupo.
      match /notes/{noteId} {
        function isGroupMember() {
          return request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        }
        allow read, create, update, delete: if isGroupMember();
      }
    }
  }
}
